{
  "name": "cloonex",
  "version": "0.1.0",
  "description": "Cloonex - local record of development intent and project knowledge, exposed to Codex via MCP",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "cloonex": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/core.test.js dist/test/idempotency.test.js dist/test/mcp.test.js",
    "mcp": "node dist/src/mcp/server.js",
    "cli": "node dist/src/cli.js",
    "sync:schema": "node scripts/sync-schema.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "node-sqlite3-wasm": "^0.8.60",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
